<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="0dp">

    <TextView
        android:id="@+id/tvAboutVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_version"
        android:textAppearance="@style/TextAppearance.TrackFix.CardTitle"
        android:textColor="@color/brand" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgAboutLogo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/about_logo_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/kr_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_developer"
                android:textAppearance="@style/TextAppearance.TrackFix.Body"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvAboutTelegram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/about_telegram"
                android:textAppearance="@style/TextAppearance.TrackFix.Body"
                android:textColor="@color/brand" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/card_stroke" />

    <LinearLayout
        android:id="@+id/rowAboutUpdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_update"
            android:textAppearance="@style/TextAppearance.TrackFix.CardTitle"
            android:textColor="@color/brand" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/about_update_hint"
            android:textAppearance="@style/TextAppearance.TrackFix.Small" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowAboutCheckUpdates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_check_updates"
            android:textAppearance="@style/TextAppearance.TrackFix.CardTitle"
            android:textColor="@color/brand" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/about_check_updates_hint"
            android:textAppearance="@style/TextAppearance.TrackFix.Small" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/about_ai"
        android:textAppearance="@style/TextAppearance.TrackFix.Body" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:autoLink="email"
        android:linksClickable="true"
        android:text="@string/about_email"
        android:textAppearance="@style/TextAppearance.TrackFix.Body"
        android:textColor="@color/brand" />
</LinearLayout>
